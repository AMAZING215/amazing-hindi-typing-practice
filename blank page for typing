<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Steno Transcription & Typing Editor</title>
  
  <!-- Fonts -->
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Tiro+Devanagari+Hindi&display=swap">
  
  <style>
    /* Webfont for Kruti Dev 010 (Ensures Kruti Dev renders properly on Android & Mobile) */
    @font-face {
      font-family: 'Kruti Dev 010';
      src: url('https://raw.githubusercontent.com/arunbabuk/kruti-dev-010-font/master/Kruti_Dev_010.ttf') format('truetype');
      font-weight: normal;
      font-style: normal;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: #f0f2f5;
      color: #222;
      display: flex;
      flex-direction: column;
      height: 100vh;
    }

    /* Header & Control Bar */
    header {
      background-color: #1a5276;
      color: white;
      padding: 10px 20px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      box-shadow: 0 2px 5px rgba(0,0,0,0.15);
    }

    .title {
      font-size: 1.1rem;
      font-weight: bold;
      letter-spacing: 0.5px;
    }

    .controls {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 10px;
    }

    select, button {
      padding: 6px 12px;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 14px;
      cursor: pointer;
      outline: none;
    }

    select {
      background: white;
      font-weight: 500;
    }

    button {
      background: #27ae60;
      color: white;
      border: none;
      font-weight: 600;
      transition: 0.2s;
    }

    button:hover {
      background: #219150;
    }

    button.btn-danger {
      background: #c0392b;
    }
    button.btn-danger:hover {
      background: #962d22;
    }

    button.btn-secondary {
      background: #34495e;
    }
    button.btn-secondary:hover {
      background: #2c3e50;
    }

    .timer-badge {
      background: #e74c3c;
      color: #fff;
      padding: 5px 12px;
      border-radius: 4px;
      font-weight: bold;
      font-size: 15px;
      min-width: 80px;
      text-align: center;
      letter-spacing: 1px;
    }

    /* Editor Main Container */
    main {
      flex: 1;
      padding: 15px 20px;
      display: flex;
      flex-direction: column;
      max-width: 1200px;
      width: 100%;
      margin: 0 auto;
    }

    .editor-wrapper {
      flex: 1;
      background: #ffffff;
      border-radius: 6px;
      box-shadow: 0 1px 4px rgba(0,0,0,0.1);
      display: flex;
      flex-direction: column;
      border: 1px solid #dcdcdc;
    }

    /* Typing Area */
    textarea {
      width: 100%;
      height: 100%;
      border: none;
      outline: none;
      resize: none;
      padding: 22px 25px;
      font-size: 20px;
      line-height: 1.8;
      color: #111;
      background: transparent;
    }

    /* Font Classes */
    .font-kruti {
      font-family: 'Kruti Dev 010', sans-serif !important;
      font-size: 22px !important;
    }

    .font-mangal {
      font-family: 'Tiro Devanagari Hindi', 'Mangal', sans-serif !important;
      font-size: 20px !important;
    }

    .font-english {
      font-family: 'Times New Roman', Times, serif !important;
      font-size: 19px !important;
    }

    /* Bottom Bar Stats */
    footer {
      background-color: #ffffff;
      border-top: 1px solid #e0e0e0;
      padding: 8px 25px;
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      font-size: 13px;
      color: #555;
    }

    .stats span {
      margin-right: 18px;
      font-weight: 600;
      color: #1a5276;
    }

    @media (max-width: 768px) {
      header {
        flex-direction: column;
        align-items: flex-start;
      }
      .controls {
        width: 100%;
      }
      main {
        padding: 10px;
      }
      textarea {
        padding: 15px;
      }
    }
  </style>
</head>
<body>

  <!-- Top Bar Controls -->
  <header>
    <div class="title">Steno Transcription Editor</div>
    
    <div class="controls">
      <!-- Font Selector -->
      <label for="fontSelect" style="font-size: 13px;">Font:</label>
      <select id="fontSelect" onchange="changeFont()">
        <option value="font-kruti" selected>Kruti Dev 010</option>
        <option value="font-mangal">Mangal (Unicode)</option>
        <option value="font-english">English (Times New Roman)</option>
      </select>

      <!-- Timer Selector: 5 to 60 Minutes -->
      <select id="timeOption">
        <option value="0">Timer Off</option>
        <option value="5">05 Min</option>
        <option value="10">10 Min</option>
        <option value="15">15 Min</option>
        <option value="20">20 Min</option>
        <option value="25">25 Min</option>
        <option value="30">30 Min</option>
        <option value="35">35 Min</option>
        <option value="40">40 Min</option>
        <option value="45">45 Min</option>
        <option value="50">50 Min</option>
        <option value="55">55 Min</option>
        <option value="60">60 Min</option>
      </select>

      <span class="timer-badge" id="timerDisplay">--:--</span>
      <button id="btnTimer" onclick="toggleTimer()">Start Timer</button>
      
      <button class="btn-secondary" onclick="downloadText()">Download (.txt)</button>
      <button class="btn-danger" onclick="clearEditor()">Clear</button>
    </div>
  </header>

  <!-- Blank Transcription Sheet -->
  <main>
    <div class="editor-wrapper">
      <textarea id="typingBox" class="font-kruti" placeholder="Yahan dictation ya matter type karein..." autofocus spellcheck="false"></textarea>
    </div>
  </main>

  <!-- Live Statistics Footer -->
  <footer>
    <div class="stats">
      Words: <span id="wordCount">0</span>
      Characters: <span id="charCount">0</span>
      Lines: <span id="lineCount">0</span>
    </div>
    <div>Strict Legal / Steno Blank Layout</div>
  </footer>

  <script>
    const typingBox = document.getElementById('typingBox');
    const fontSelect = document.getElementById('fontSelect');
    const wordCount = document.getElementById('wordCount');
    const charCount = document.getElementById('charCount');
    const lineCount = document.getElementById('lineCount');
    const timerDisplay = document.getElementById('timerDisplay');
    const timeOption = document.getElementById('timeOption');
    const btnTimer = document.getElementById('btnTimer');

    let countdownInterval = null;
    let timeLeft = 0;

    // Font changer
    function changeFont() {
      typingBox.className = fontSelect.value;
      typingBox.focus();
    }

    // Word & Character Counter
    typingBox.addEventListener('input', () => {
      const text = typingBox.value;
      charCount.textContent = text.length;

      const cleanWords = text.trim().split(/\s+/).filter(w => w.length > 0);
      wordCount.textContent = cleanWords.length;

      const lines = text.split('\n').filter(l => l.length > 0);
      lineCount.textContent = lines.length;
    });

    // Timer Controls
    function toggleTimer() {
      if (countdownInterval) {
        clearInterval(countdownInterval);
        countdownInterval = null;
        btnTimer.textContent = "Start Timer";
        btnTimer.style.background = "#27ae60";
        return;
      }

      const mins = parseInt(timeOption.value);
      if (mins === 0) {
        alert("Kripya pehle drop-down se samay (5 - 60 min) chunein.");
        return;
      }

      timeLeft = mins * 60;
      updateDisplay();

      btnTimer.textContent = "Stop";
      btnTimer.style.background = "#c0392b";

      countdownInterval = setInterval(() => {
        timeLeft--;
        updateDisplay();
        if (timeLeft <= 0) {
          clearInterval(countdownInterval);
          countdownInterval = null;
          alert("Time Up! Transcription ka samay samapt ho gaya.");
          btnTimer.textContent = "Start Timer";
          btnTimer.style.background = "#27ae60";
        }
      }, 1000);
    }

    function updateDisplay() {
      const h = Math.floor(timeLeft / 3600);
      const m = Math.floor((timeLeft % 3600) / 60);
      const s = timeLeft % 60;

      if (h > 0) {
        timerDisplay.textContent = `${h}:${m < 10 ? '0' + m : m}:${s < 10 ? '0' + s : s}`;
      } else {
        timerDisplay.textContent = `${m < 10 ? '0' + m : m}:${s < 10 ? '0' + s : s}`;
      }
    }

    // Clear Text
    function clearEditor() {
      if (typingBox.value.length > 0) {
        if (confirm("Kya aap pura matter hatana chahte hain?")) {
          typingBox.value = "";
          wordCount.textContent = "0";
          charCount.textContent = "0";
          lineCount.textContent = "0";
        }
      }
    }

    // Save as .txt File
    function downloadText() {
      const text = typingBox.value;
      if (!text) {
        alert("Download karne ke liye pehle kuch type karein!");
        return;
      }
      const blob = new Blob([text], { type: "text/plain;charset=utf-8" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = `Steno_Matter_${new Date().toISOString().slice(0,10)}.txt`;
      link.click();
    }
  </script>
</body>
</html>
